            },
            {
              "column": "summary",
              "value": "={{ $('Parse Analysis JSON').item.json.summary }}"
            },
            {
              "column": "recording_url",
              "value": "={{ $('Merge Transcript').item.json.recording_url }}"
            }
          ]
        }
      },
      "id": "supabase-insert-call",
      "name": "Insert Voice Call",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2050, 350],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-lx-cred",
          "name": "Supabase-LX"
        }
      },
      "notesInFlow": true,
      "notes": "Enregistre l'appel dans Supabase"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/{{ $env.TWILIO_ACCOUNT_SID }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
