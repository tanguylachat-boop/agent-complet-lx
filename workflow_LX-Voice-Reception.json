        }
      },
      "notesInFlow": true,
      "notes": "Envoie un SMS de récapitulation"
    },
    {
      "parameters": {
        "operation": "sendEmail",
        "fromEmail": "contact@lxstudio.ch",
        "toEmail": "contact@lxstudio.ch",
        "subject": "Nouvel appel entrant - {{ $('Parse Analysis JSON').item.json.intent }}",
        "emailFormat": "text",
        "text": "=📞 NOUVEL APPEL ENTRANT\n\nDe : {{ $('Merge Transcript').item.json.phone_from }}\nVers : {{ $('Merge Transcript').item.json.phone_to }}\nStatut : {{ $('Merge Transcript').item.json.call_status }}\n\nINTENTION : {{ $('Parse Analysis JSON').item.json.intent }}\nURGENCE : {{ $('Parse Analysis JSON').item.json.urgency }}\nSENTIMENT : {{ $('Parse Analysis JSON').item.json.sentiment }}\n\nRÉSUMÉ :\n{{ $('Parse Analysis JSON').item.json.summary }}\n\nACTION REQUISE : {{ $('Parse Analysis JSON').item.json.action_required ? 'OUI - Rappel nécessaire' : 'Non - Suivi automatique' }}\n\nQUALITÉ LEAD : {{ $('Parse Analysis JSON').item.json.lead_quality }}\n\n---\nTRANSCRIPTION COMPLÈTE :\n{{ $('Merge Transcript').item.json.transcript }}\n\n---\nCall SID : {{ $('Merge Transcript').item.json.call_sid }}\nEnregistrement : {{ $('Merge Transcript').item.json.recording_url || 'Non disponible' }}",
        "options": {}
      },
      "id": "smtp-send-recap",
      "name": "Email Recap to Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [2250, 450],
      "credentials": {
