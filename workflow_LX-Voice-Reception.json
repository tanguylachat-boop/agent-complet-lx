        "text": "📞 *Nouvel appel entrant*\n\n*De:* {{ $('Merge Transcript').item.json.phone_from }}\n*Intent:* {{ $('Parse Analysis JSON').item.json.intent }}\n*Urgence:* {{ $('Parse Analysis JSON').item.json.urgency }}\n*Sentiment:* {{ $('Parse Analysis JSON').item.json.sentiment }}\n\n*Résumé:*\n{{ $('Parse Analysis JSON').item.json.summary }}\n\n{{ $('Parse Analysis JSON').item.json.action_required ? '⚠️ *ACTION REQUISE*' : '✅ Suivi automatique' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify",
