      "parameters": {
        "jsCode": "// Check idempotency\n\nconst item = $input.item.json;\nconst workflow = item.workflow || 'unknown';\nconst key = item.idempotency_key;\n\nif (!key) {\n  throw new Error('idempotency_key is required');\n}\n\nreturn {\n  json: {\n    workflow,\n    idempotency_key: key\n  }\n};"
      },
