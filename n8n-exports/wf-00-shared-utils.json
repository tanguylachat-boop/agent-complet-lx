    {
      "parameters": {
        "jsCode": "// Format Telegram notification\n\nconst item = $input.item.json;\nconst title = item.title || 'Notification';\nconst text = item.text || 'No message';\nconst severity = item.severity || 'info';\n\n// Emoji mapping\nconst emojis = {\n  info: 'ℹ️',\n  warn: '⚠️',\n  error: '❌',\n  success: '✅'\n};\n\nconst emoji = emojis[severity] || 'ℹ️';\n\n// Format message\nconst message = `${emoji} *${title}*\\n\\n${text}`;\n\nreturn {\n  json: {\n    chat_id: $env.TELEGRAM_CHAT_ID,\n    text: message,\n    parse_mode: 'Markdown'\n  }\n};"
      },
