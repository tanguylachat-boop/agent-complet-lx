        "jsCode": "// Error handler: log + notify\n\nconst item = $input.item.json;\nconst workflow = item.workflow || 'unknown';\nconst step = item.step || 'unknown';\nconst error = item.error || 'Unknown error';\nconst context = item.context || {};\n\nconst errorLog = {\n  workflow,\n  run_id: context.run_id || null,\n  step,\n  level: 'error',\n  message: error,\n  payload: context\n};\n\nreturn {\n  json: errorLog\n};"
      },
