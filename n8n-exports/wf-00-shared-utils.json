    {
      "parameters": {
        "jsCode": "// Mask sensitive data and truncate if > 4KB\n\nconst item = $input.item.json;\n\n// Sensitive keys to mask\nconst sensitiveKeys = [\n  'password', 'token', 'api_key', 'secret', 'apikey',\n  'authorization', 'credit_card', 'ssn', 'stripe_key',\n  'private_key', 'client_secret'\n];\n\nfunction maskSensitiveData(obj) {\n  if (!obj) return obj;\n  const masked = JSON.parse(JSON.stringify(obj));\n  \n  function recurse(o) {\n    for (let key in o) {\n      if (typeof o[key] === 'object' && o[key] !== null) {\n        recurse(o[key]);\n      } else if (sensitiveKeys.some(sk => key.toLowerCase().includes(sk))) {\n        o[key] = '***MASKED***';\n      }\n    }\n  }\n  \n  recurse(masked);\n  return masked;\n}\n\nfunction truncatePayload(payload, maxBytes = 4096) {\n  if (!payload) return null;\n  let json = JSON.stringify(payload);\n  \n  if (Buffer.byteLength(json, 'utf8') <= maxBytes) {\n    return payload;\n  }\n  \n  // Truncate with indicator\n  const truncated = json.substring(0, maxBytes - 50);\n  try {\n    return JSON.parse(truncated + '\"... [TRUNCATED]\"}');\n  } catch (e) {\n    return { _truncated: true, _original_size: json.length };\n  }\n}\n\nconst maskedPayload = item.payload ? maskSensitiveData(item.payload) : null;\nconst finalPayload = truncatePayload(maskedPayload);\n\nreturn {\n  json: {\n    workflow: item.workflow || 'unknown',\n    run_id: item.run_id || null,\n    step: item.step || null,\n    level: item.level || 'info',\n    message: item.message || 'No message',\n    payload: finalPayload\n  }\n};"
      },
      "id": "function-mask-log",
      "name": "01 Mask & Truncate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
