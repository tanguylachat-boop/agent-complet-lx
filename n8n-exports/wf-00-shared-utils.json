              "value": "={{ $json.message }}"
            },
            {
              "name": "payload",
              "value": "={{ JSON.stringify($json.payload) }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "retry": {
            "maxRetries": 3,
            "retryOnStatusCodeList": [500, 502, 503, 504]
          }
        }
      },
