{
  "name": "WF-05 Closing Assist",
  "nodes": [
    {
      "parameters": {
        "path": "pre-meeting-brief",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-pre-meeting",
      "name": "Webhook Pre-Meeting",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 400],
      "webhookId": "pre-meeting-brief"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/companies?id=eq.{{ $json.company_id }}&select=*,audits(*),specs(*),estimates(*)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}"},
            {"name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"}
          ]
        },
        "options": {}
      },
      "id": "fetch-company-data",
      "name": "01 Fetch Company Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.ANTHROPIC_MODEL }}\",\n  \"max_tokens\": 2048,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Génère un BRIEF DE VENTE (1 page max) pour le RDV de closing avec ce prospect :\\n\\n{{ JSON.stringify($json[0], null, 2) }}\\n\\nInclure :\\n- Points clés de l'audit\\n- Valeur ajoutée LX Studio\\n- ROI attendu\\n- Objections possibles + réponses\\n- Closing tips\\n\\nFormat Markdown.\"\n  }]\n}",
        "options": {"timeout": 30000}
      },
      "id": "ai-generate-brief",
      "name": "02 AI Generate Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "jsCode": "const brief = $input.item.json.content[0].text;\nconst company = $('01 Fetch Company Data').item.json[0];\n\nreturn {\n  json: {\n    title: `📋 Brief de Vente - ${company.name}`,\n    text: brief,\n    severity: 'info'\n  }\n};"
      },
      "id": "format-telegram",
      "name": "03 Format Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BASE_DOMAIN }}/webhook/utils-notify-telegram",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "send-telegram",
      "name": "04 Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Brief sent to Telegram' }) }}"
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 400]
    }
  ],
  "connections": {
    "Webhook Pre-Meeting": {"main": [[{"node": "01 Fetch Company Data", "type": "main", "index": 0}]]},
    "01 Fetch Company Data": {"main": [[{"node": "02 AI Generate Brief", "type": "main", "index": 0}]]},
    "02 AI Generate Brief": {"main": [[{"node": "03 Format Telegram", "type": "main", "index": 0}]]},
    "03 Format Telegram": {"main": [[{"node": "04 Send to Telegram", "type": "main", "index": 0}]]},
    "04 Send to Telegram": {"main": [[{"node": "Respond Success", "type": "main", "index": 0}]]}
  },
  "pinData": {},
