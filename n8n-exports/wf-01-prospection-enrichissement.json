        "url": "={{ $env.BASE_DOMAIN }}/webhook/utils-log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "call-log-start",
      "name": "Call Log Utils",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://maps.googleapis.com/maps/api/place/textsearch/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query || 'PME Jura Suisse' }}"
            },
            {
              "name": "key",
              "value": "={{ $env.GOOGLE_PLACES_API_KEY }}"
            },
            {
              "name": "region",
              "value": "ch"
            },
            {
              "name": "language",
              "value": "fr"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "retry": {
            "maxRetries": 3,
            "retryOnStatusCodeList": [429, 500, 502, 503, 504]
          }
        }
      },
      "id": "http-google-places",
      "name": "01 Fetch Google Places",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "jsCode": "// Normalize and deduplicate companies from Google Places\n\nconst crypto = require('crypto');\n\nconst results = $input.item.json.results || [];\n\nfunction generateHash(name, address) {\n  const normalized = `${name}${address}`.toLowerCase().replace(/\\s+/g, '');\n  return crypto.createHash('md5').update(normalized).digest('hex');\n}\n\nfunction normalizePhone(phone) {\n  if (!phone) return null;\n  return phone.replace(/[^0-9+]/g, '');\n}\n\nconst companies = results.map(place => {\n  const name = place.name;\n  const address = place.formatted_address || '';\n  const hash = generateHash(name, address);\n  \n  return {\n    name: name,\n    address: address,\n    city: place.vicinity || null,\n    postal_code: null, // extract from address if needed\n    country: 'CH',\n    phone: null, // Google Places basic doesn't always have phone\n    website: null,\n    industry: place.types?.[0] || null,\n    source: 'google_places',\n    status: 'prospect',\n    hash_key: hash,\n    google_place_id: place.place_id,\n    rating: place.rating || null,\n    user_ratings_total: place.user_ratings_total || 0\n  };\n});\n\n// Deduplicate by hash_key\nconst unique = companies.reduce((acc, company) => {\n  if (!acc.find(c => c.hash_key === company.hash_key)) {\n    acc.push(company);\n  }\n  return acc;\n}, []);\n\nreturn unique.map(c => ({ json: c }));"
      },
      "id": "function-normalize",
      "name": "02 Normalize & Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "jsCode": "// Log normalization results\nconst count = $input.all().length;\n\nreturn [{\n  json: {\n    workflow: 'wf-01-prospection',\n    run_id: $execution.id,\n    step: '02 Normalize & Dedup',\n    level: 'info',\n    message: `Normalized ${count} unique companies`,\n    payload: {\n      count: count,\n      sample: $input.first().json\n    }\n  }\n}];"
      },
      "id": "log-normalize",
      "name": "Log Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
