              "name": "message",
              "value": "={{ $json.facebook_instagram.text + '\\n\\n' + $json.facebook_instagram.hashtags.join(' ') + '\\n\\n' + $('Parse Payload').item.json.blog_url }}"
            }
          ]
        },
        "options": {}
      },
