# ===================================================
# LX Studio - n8n Environment Variables
# ===================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ===================================================

# ===================================================
# N8N CONFIGURATION
# ===================================================
BASE_URL_N8N=https://your-n8n-instance.com
N8N_ENCRYPTION_KEY=your_random_encryption_key_here

# ===================================================
# SUPABASE
# ===================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ===================================================
# EMAIL (SMTP & IMAP)
# ===================================================
# For contact@lxstudio.ch
SMTP_HOST=smtp.infomaniak.com
SMTP_PORT=465
SMTP_USER=contact@lxstudio.ch
SMTP_PASSWORD=your_smtp_password_here
SMTP_SECURE=true
SMTP_FROM_EMAIL=contact@lxstudio.ch
SMTP_FROM_NAME=LX Studio

IMAP_HOST=imap.infomaniak.com
IMAP_PORT=993
IMAP_USER=contact@lxstudio.ch
IMAP_PASSWORD=your_imap_password_here
IMAP_SECURE=true

# ===================================================
# STRIPE
# ===================================================
STRIPE_API_KEY=sk_test_or_live_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===================================================
# WORDPRESS
# ===================================================
WP_URL=https://lxstudio.ch
WP_USERNAME=your_wp_username
WP_APPLICATION_PASSWORD=your_wp_app_password_here

# ===================================================
# TELEGRAM
# ===================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===================================================
# TWILIO (Voice & SMS)
# ===================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+41xxxxxxxxx

# ===================================================
# ANTHROPIC (Claude API)
# ===================================================
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here

# ===================================================
# SOCIAL MEDIA APIs
# ===================================================

# Meta (Facebook & Instagram)
META_ACCESS_TOKEN=your_meta_access_token_here
META_PAGE_ID=your_facebook_page_id_here
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:your_linkedin_id_here

# X (Twitter)
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Buffer (Alternative social posting)
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# ===================================================
# EXTERNAL SERVICES
# ===================================================

# Calendly
CALENDLY_LINK=https://calendly.com/lxstudio/consultation

# Sitemap ping
SITEMAP_URL=https://lxstudio.ch/sitemap.xml

# ===================================================
# SECURITY & RATE LIMITING
# ===================================================

# Hash secret for idempotence & security
HASH_SECRET=your_random_hash_secret_here

# Rate limiting
PROSPECT_DAILY_LIMIT=80
PROSPECT_BATCH_SIZE=10
PROSPECT_BATCH_DELAY_SECONDS=40

# ===================================================
# PRICING & BUSINESS RULES
# ===================================================

# CHF pricing (for quote generation)
PRICING_WEBSITE_BASE=2500
PRICING_WEBSITE_ECOMMERCE=5000
PRICING_WEBSITE_CUSTOM=8000
PRICING_MAINTENANCE_MONTHLY=200
PRICING_SEO_MONTHLY=500
PRICING_AUTOMATION_HOURLY=150

# VAT rate (Switzerland)
VAT_RATE=0.077

# Payment terms
PAYMENT_TERMS_DAYS=30

# ===================================================
# LOCALIZATION
# ===================================================
DEFAULT_LANGUAGE=fr
DEFAULT_TIMEZONE=Europe/Zurich
DEFAULT_CURRENCY=CHF

# ===================================================
# FEATURE FLAGS
# ===================================================
ENABLE_AUTO_BLOG=true
ENABLE_AUTO_SOCIAL=true
ENABLE_VOICE_PROCESSING=true
ENABLE_PROSPECTING=true

# ===================================================
# MONITORING & ALERTS
# ===================================================
ERROR_NOTIFICATION_EMAIL=contact@lxstudio.ch
ERROR_NOTIFICATION_TELEGRAM=true

# Sentry (optional)
# SENTRY_DSN=https://your_sentry_dsn_here

# ===================================================
# DEVELOPMENT / STAGING
# ===================================================
# NODE_ENV=production
# DEBUG=false
