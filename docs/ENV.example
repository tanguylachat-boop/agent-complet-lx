# ============================================================================
# LX Studio - n8n Automation Pipeline Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ----------------------------------------------------------------------------
# BASE CONFIGURATION
# ----------------------------------------------------------------------------
TIMEZONE=Europe/Zurich
BASE_DOMAIN=https://automations.lxstudio.ch

# Company info (used in emails/documents)
COMPANY_NAME=LX Studio
COMPANY_EMAIL=contact@lxstudio.ch
COMPANY_PHONE=+41 XX XXX XX XX
COMPANY_ADDRESS=Rue Example 123, 2800 Delémont, Suisse

# ----------------------------------------------------------------------------
# SUPABASE / POSTGRES
# ----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Direct Postgres connection (optional, for migrations)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# STRIPE PAYMENTS
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ID_MAINTENANCE=prod_xxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# EMAIL (SMTP)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=automation@lxstudio.ch
SMTP_PASS=your-app-specific-password
FROM_EMAIL=automation@lxstudio.ch
FROM_NAME=LX Studio - Automatisation

# Alternative: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# GOOGLE WORKSPACE
# ----------------------------------------------------------------------------
# OAuth2 credentials (create in Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx

# Specific resource IDs
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=1XxXxXxXxXxXxXxXxXxXxXxXxXxXxXxX

# Document templates (Google Docs)
GOOGLE_TEMPLATE_AUDIT=1AuditTemplateXxXxXxXxXxXxXxXxXxX
GOOGLE_TEMPLATE_CDC=1CDCTemplateXxXxXxXxXxXxXxXxXxXx
GOOGLE_TEMPLATE_PROPOSAL=1ProposalTemplateXxXxXxXxXxXxXxX
GOOGLE_TEMPLATE_CONTRACT=1ContractTemplateXxXxXxXxXxXxXxX

# ----------------------------------------------------------------------------
# NOTION
# ----------------------------------------------------------------------------
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxx
NOTION_DB_PROJECTS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TASKS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TEMPLATE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# TYPEFORM
# ----------------------------------------------------------------------------
TYPEFORM_TOKEN=tfp_xxxxxxxxxxxxxxxxxxxxx
TYPEFORM_AUDIT_ID=XxXxXxXx
TYPEFORM_ONBOARDING_ID=YyYyYyYy
TYPEFORM_UAT_ID=ZzZzZzZz
TYPEFORM_NPS_ID=NpNpNpNp

# ----------------------------------------------------------------------------
# AI / LLM
# ----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Use which provider? (openai|anthropic)
AI_PROVIDER=anthropic

# ----------------------------------------------------------------------------
# VOICE / PHONE
# ----------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+41xxxxxxxxx

# Alternative: VAPI.ai (AI voice agent)
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxx
VAPI_ASSISTANT_ID=xxxxxxxxxxxxxxxxxxxxx

# Alternative: ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxx

# Use which provider? (twilio|vapi|elevenlabs)
VOICE_PROVIDER=vapi

# ----------------------------------------------------------------------------
# ENRICHMENT & DATA
# ----------------------------------------------------------------------------
# Hunter.io (email finder)
HUNTER_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Clearbit (enrichment, optional)
CLEARBIT_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxx

# Google Places API (for prospection)
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# MESSAGING & ALERTS
# ----------------------------------------------------------------------------
# Telegram Bot (for internal notifications)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Slack (alternative)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Use which notification channel? (telegram|slack|email)
NOTIFICATION_CHANNEL=telegram

# ----------------------------------------------------------------------------
# RATE LIMITING & QUOTAS
# ----------------------------------------------------------------------------
# Max requests per second for external APIs
RATE_LIMIT_GOOGLE=5
RATE_LIMIT_STRIPE=10
RATE_LIMIT_AI=3
RATE_LIMIT_EMAIL=2

# ----------------------------------------------------------------------------
# BUSINESS LOGIC PARAMETERS
# ----------------------------------------------------------------------------
# Estimation defaults
DEFAULT_HOURLY_RATE_CHF=150
DEFAULT_BUFFER_PERCENT=20
COMPLEXITY_LOW_HOURS=8
COMPLEXITY_MEDIUM_HOURS=24
COMPLEXITY_HIGH_HOURS=60

# Payment splits
DEPOSIT_PERCENT=30
BALANCE_PERCENT=70

# Timing
FOLLOW_UP_DAYS=3
REMINDER_DAYS_BEFORE_MEETING=1
LOG_RETENTION_DAYS=90

# Business hours (for scheduling)
BUSINESS_HOURS_START=08:30
BUSINESS_HOURS_END=17:30
BUSINESS_DAYS=1,2,3,4,5

# ----------------------------------------------------------------------------
# SECURITY & OBSERVABILITY
# ----------------------------------------------------------------------------
# Enable detailed logging (true|false)
ENABLE_DEBUG_LOGS=false

# Mask sensitive data in logs (true|false)
MASK_SENSITIVE_DATA=true

# Webhook signature verification (true|false)
VERIFY_WEBHOOK_SIGNATURES=true

# ----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ----------------------------------------------------------------------------
# GitHub (for client project repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=lxstudio-clients

# Sentry (error tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# Datadog (monitoring)
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxx
DATADOG_APP_KEY=xxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# WEBHOOK ENDPOINTS (auto-configured by n8n)
# ----------------------------------------------------------------------------
# These are generated when you activate webhooks in n8n
# Format: {BASE_DOMAIN}/webhook/{workflow-trigger-path}

# WEBHOOK_PROSPECT_SYNC={BASE_DOMAIN}/webhook/prospect-sync
# WEBHOOK_CONTACT_START={BASE_DOMAIN}/webhook/contact-start
# WEBHOOK_TYPEFORM_AUDIT={BASE_DOMAIN}/webhook/typeform-audit
# WEBHOOK_VOICE_AUDIT={BASE_DOMAIN}/webhook/voice-audit
# WEBHOOK_PROPOSAL_ACCEPTED={BASE_DOMAIN}/webhook/proposal-accepted
# WEBHOOK_STRIPE_PAYMENT={BASE_DOMAIN}/webhook/stripe-payment
# WEBHOOK_ONBOARDING_COMPLETED={BASE_DOMAIN}/webhook/onboarding-completed
# WEBHOOK_READY_FOR_UAT={BASE_DOMAIN}/webhook/ready-for-uat
