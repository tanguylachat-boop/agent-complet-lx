# ============================================================================
# LX Studio - n8n Workflows Test Payloads
# ============================================================================
# Utilisation : VS Code avec l'extension "REST Client"
# Ou Postman/Insomnia en copiant les requêtes
#
# 1. Remplacer {{BASE_DOMAIN}} par votre URL n8n
# 2. Activer les workflows dans n8n avant de tester
# 3. Vérifier les logs dans Supabase après chaque requête
# ============================================================================

@BASE_DOMAIN = https://automations.lxstudio.ch

# ============================================================================
# WF-00 - SHARED UTILS (Workflows utilitaires)
# ============================================================================

### Test: utils-log (INFO)
POST {{BASE_DOMAIN}}/webhook/utils-log
Content-Type: application/json

{
  "workflow": "test-manual",
  "run_id": "test-12345",
  "step": "Manual Test",
  "level": "info",
  "message": "Testing log utility",
  "payload": {
    "test": true,
    "timestamp": "2025-01-15T10:30:00Z"
  }
}

### Test: utils-log (ERROR)
POST {{BASE_DOMAIN}}/webhook/utils-log
Content-Type: application/json

{
  "workflow": "test-manual",
  "run_id": "test-12345",
  "step": "Manual Test",
  "level": "error",
  "message": "Testing error logging",
  "payload": {
    "error": "Sample error for testing",
    "context": {
      "company_id": "123e4567-e89b-12d3-a456-426614174000"
    }
  }
}

### Test: utils-idempotency-check (first call)
POST {{BASE_DOMAIN}}/webhook/utils-idempotency-check
Content-Type: application/json

{
  "workflow": "test-manual",
  "idempotency_key": "test-key-12345-abc"
}

### Test: utils-idempotency-check (duplicate call)
POST {{BASE_DOMAIN}}/webhook/utils-idempotency-check
Content-Type: application/json

{
  "workflow": "test-manual",
  "idempotency_key": "test-key-12345-abc"
}

### Test: utils-notify-telegram
POST {{BASE_DOMAIN}}/webhook/utils-notify-telegram
Content-Type: application/json

{
  "title": "Test Notification",
  "text": "Ceci est un test de notification Telegram depuis n8n",
  "severity": "info"
}

### Test: utils-error-handler
POST {{BASE_DOMAIN}}/webhook/utils-error-handler
Content-Type: application/json

{
  "workflow": "test-manual",
  "step": "Test Step",
  "error": "Sample error message",
  "context": {
    "company_id": "123e4567-e89b-12d3-a456-426614174000",
    "action": "test_action"
  }
}

