### Webhook: Ready for UAT
POST {{BASE_DOMAIN}}/webhook/ready-for-uat
Content-Type: application/json

{
  "project_id": "proj-123e4567-e89b-12d3-a456-426614174004",
  "company_id": "123e4567-e89b-12d3-a456-426614174000",
  "workflows_count": 5,
  "ready_date": "2025-02-15T10:00:00Z"
}

### Webhook: UAT Checklist Submitted
POST {{BASE_DOMAIN}}/webhook/uat-checklist
Content-Type: application/json

{
  "form_response": {
    "form_id": "ZzZzZzZz",
    "submitted_at": "2025-02-20T14:00:00Z",
    "hidden": {
      "project_id": "proj-123e4567-e89b-12d3-a456-426614174004"
    },
    "answers": [
      {
        "type": "boolean",
        "boolean": true,
        "field": { "ref": "flows_working" }
      },
      {
        "type": "text",
        "text": "Un problème mineur sur le flow facturation : les dates ne sont pas au bon format",
        "field": { "ref": "errors_found" }
      },
      {
        "type": "boolean",
        "boolean": true,
        "field": { "ref": "performance_ok" }
      },
      {
        "type": "boolean",
        "boolean": true,
        "field": { "ref": "docs_clear" }
      },
      {
        "type": "boolean",
        "boolean": false,
        "field": { "ref": "ready_golive" }
      }
    ]
  }
}

