}

### Webhook: Stripe Subscription Payment Failed
POST {{BASE_DOMAIN}}/webhook/stripe-payment
Content-Type: application/json

{
  "id": "evt_stripe_invoice_fail",
  "type": "invoice.payment_failed",
  "data": {
    "object": {
      "id": "in_12345",
      "customer": "cus_ABC123",
      "subscription": "sub_XYZ789",
      "amount_due": 29900,
      "currency": "chf",
      "attempt_count": 1,
      "metadata": {
        "company_id": "123e4567-e89b-12d3-a456-426614174000"
      }
    }
  }
}

# ============================================================================
# VERIFICATION QUERIES (Supabase)
# ============================================================================

### Après tests, vérifier dans Supabase :

# SELECT * FROM execution_logs ORDER BY created_at DESC LIMIT 20;
# SELECT * FROM idempotency_keys ORDER BY created_at DESC LIMIT 10;
# SELECT * FROM companies WHERE name LIKE '%Jura%';
# SELECT * FROM audits ORDER BY created_at DESC LIMIT 5;
# SELECT * FROM payments ORDER BY created_at DESC LIMIT 5;
